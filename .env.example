APP_ENV=dev
DEBUG=true

USE_MOCK_MODEL=true
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=gpt-4o-mini
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=800
MODEL_TIMEOUT_SECONDS=30

MAX_HISTORY_ROUNDS=6

# 模型权重路径（默认已指向 weights/ 目录，通常不需要修改）
# ECG 心电模型权重（CODE15 6类分类）
ECG_CHECKPOINT=weights/CODE15_Pretrain_student_checkpoint.pt
# PCG 心音模型权重（正常/异常二分类）
PCG_CHECKPOINT=weights/CirCorDigiScopePCG_LSTrans_student_checkpoint.pt
